{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/freol35241/adml/schemas/models-catalog.schema.json",
  "title": "ADML Models Catalog",
  "description": "Schema for the machine-readable catalog of ADML dynamical models",
  "type": "object",
  "required": ["version", "models"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Catalog version following semver"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the catalog"
    },
    "models": {
      "type": "array",
      "description": "List of all models in the library",
      "items": {
        "$ref": "#/definitions/model"
      }
    },
    "categories": {
      "type": "object",
      "description": "Category definitions",
      "additionalProperties": {
        "$ref": "#/definitions/category"
      }
    },
    "statistics": {
      "type": "object",
      "description": "Aggregate statistics",
      "properties": {
        "total_models": { "type": "integer" },
        "simple_models": { "type": "integer" },
        "medium_models": { "type": "integer" },
        "advanced_models": { "type": "integer" }
      }
    }
  },
  "definitions": {
    "model": {
      "type": "object",
      "required": ["name", "package", "path", "category", "version"],
      "properties": {
        "name": {
          "type": "string",
          "description": "CamelCase model name (matches struct name)",
          "pattern": "^[A-Z][a-zA-Z0-9]*$"
        },
        "package": {
          "type": "string",
          "description": "Cargo package name",
          "pattern": "^adml-[a-z0-9-]+$"
        },
        "path": {
          "type": "string",
          "description": "Relative path to model directory",
          "pattern": "^models/[a-z]+/[a-z0-9-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["mathematical", "mechanical", "electrical", "thermal", "hydraulic", "chemical", "other"],
          "description": "Model category"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Model version"
        },
        "complexity": {
          "type": "string",
          "enum": ["simple", "medium", "advanced"],
          "description": "Implementation complexity"
        },
        "states": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of state variables"
        },
        "parameters": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tunable parameters"
        },
        "features": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Model features/characteristics"
        },
        "equations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Differential equations in string format"
        },
        "fmu_name": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z0-9]*\\.fmu$",
          "description": "Generated FMU filename"
        },
        "description": {
          "type": "string",
          "description": "Human-readable model description"
        }
      }
    },
    "category": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "Category description"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of models in category"
        }
      }
    }
  }
}
